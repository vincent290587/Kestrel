/*
 * Phase 11: first real board definition for the custom stravaV11 PCB
 * (PROTO_V11 / v3 revision, per stravaV10's custom_board.h/custom_board_v3.h
 * -- confirmed with the user as the board actually connected). Same nRF52840
 * SoC as the DK, modeled on nrf52840dk_nrf52840.dts, but every pin
 * assignment below comes from the real PCB (custom_board_v3.h), not the DK's
 * Arduino header -- see stravav11_nrf52840-pinctrl.dtsi.
 *
 * Deliberately not console = a uart: custom_board_v3.h defines only one
 * UART pin pair, dedicated to the GPS module (source/sensors/GPSMGMT.cpp) --
 * there's no separate debug UART broken out on this board. Console/logging
 * goes over RTT instead (see stravav11_nrf52840_defconfig).
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition.dtsi>
#include "stravav11_nrf52840-pinctrl.dtsi"

/ {
	model = "stravaV11 custom PCB (PROTO_V11)";
	compatible = "vincent,stravav11-nrf52840";

	chosen {
		zephyr,display = &ls027;
		/* Tells Partition Manager mx25r64 (the real MT25QL128 chip
		 * here) is a valid "external_flash" region -- see the
		 * raw-NOR-disk node near the mx25r64 definition below. */
		nordic,pm-ext-flash = &mx25r64;
	};

	leds {
		compatible = "gpio-leds";

		/* LED_1, P1.04, active low (LEDS_ACTIVE_STATE 0). */
		led0: led_0 {
			gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
			label = "Status LED";
		};
	};

	buttons {
		compatible = "gpio-keys";

		/* BUTTON_1/2/3, active low with pull-up (BUTTONS_ACTIVE_STATE 0). */
		button0: button_0 {
			gpios = <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 1";
		};

		button1: button_1 {
			gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 2";
		};

		button2: button_2 {
			gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 3";
		};
	};

	aliases {
		led0 = &led0;
		sw0 = &button0;
		sw1 = &button1;
		sw2 = &button2;
		watchdog0 = &wdt0;
	};

	/* GPS module control/status GPIOs (GPS_R/GPS_S/FIX_PIN in
	 * custom_board_v3.h), not driven by any code yet -- neither the
	 * unported real GPSMGMT.cpp hardware layer nor this port's
	 * uart_demo() touch them, which is the likely reason the GPS UART
	 * receives unexplained bytes on every boot (see CLAUDE.md Phase 11):
	 * with both left floating/undriven, the module is never actually
	 * held in reset or standby, so it's free to run and transmit on its
	 * own. Polarity (active-low reset/standby, active-high fix) is taken
	 * from the only place in the codebase that encodes it --
	 * TDD/Simulator.cpp only emits NMEA data once
	 * `gpio_get(GPS_R) && gpio_get(GPS_S)` are both high, and drives
	 * FIX_PIN high to signal a fix -- not from any real hardware driver,
	 * since GPSMGMT.cpp's actual pin handling was never ported (Phase 6).
	 */
	zephyr_user: zephyr,user {
		gps-reset-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		gps-standby-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
		gps-fix-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
	};
};

&reg0 {
	status = "okay";
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/* GPS module (source/sensors/GPSMGMT.cpp), GPS_DEFAULT_SPEED_BAUD.
 * Labeled arduino_serial (not literally an Arduino pin on this board) only
 * so main.c's uart_demo(), written for the DK bring-up build, compiles
 * unchanged against this board too. */
arduino_serial: &uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Sensor bus: bme280, fxos8700, FRAM (mb85rcxx). STC3100/VEML6075 share
 * this bus too but don't have Zephyr drivers yet -- see CLAUDE.md Phase 3.
 * Labeled arduino_i2c for the same main.c source-compat reason as
 * arduino_serial above -- this is not the Arduino header on this board. */
arduino_i2c: &i2c0 {
	compatible = "nordic,nrf-twi";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	bme280: bme280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
	};

	fxos8700: fxos8700@1e {
		compatible = "nxp,fxos8700";
		reg = <0x1e>;
		/* FXOS_INT1 / FXOS_RST from custom_board_v3.h. */
		int1-gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
	};

	fram: mb85rc@50 {
		compatible = "fujitsu,mb85rcxx";
		reg = <0x50>;
		size = <2048>;
		address-width = <8>;
	};
};

/* LS027 display, LS027_CS_PIN as a plain GPIO chip-select. Active HIGH,
 * not the more common active-low convention -- zephyr/drivers/display/
 * ls0xx.c hardcodes SPI_CS_ACTIVE_HIGH in its own spi_config, and the
 * DK overlay's own arduino_spi cs-gpios (Phase 2) already got this right;
 * this board's version had it backwards (GPIO_ACTIVE_LOW), corrupting
 * every SPI transaction to the display -- found via real-glass output
 * that looked like noise, not the intended shapes, on the very first
 * physical LS027 this port has ever been visually checked against. */
&spi2 {
	compatible = "nordic,nrf-spi";
	status = "okay";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	/* No VCOM-related properties: VCOM on this board is toggled by a
	 * hardware circuit, not software (confirmed with the user) -- so
	 * neither serial-vcom-inversion (the v3.3.4-only in-band SPI
	 * approach this port used before, which turned out to be
	 * unnecessary all along) nor extcomin-gpios (a dedicated MCU pin
	 * this board doesn't have) apply. ls0xx.c gates all of its VCOM
	 * toggling code behind DT_INST_NODE_HAS_PROP(0, extcomin_gpios); with
	 * neither property present, the driver only ever does plain SPI
	 * content writes and never touches VCOM, which is exactly correct
	 * here. This also means the driver doesn't need the v3.3.4-only
	 * serial-vcom-inversion binding property, so this node works
	 * unmodified on sdk-nrf v3.2.4 too. */
	ls027: ls0xx@0 {
		compatible = "sharp,ls0xx";
		reg = <0>;
		spi-max-frequency = <2000000>;
		width = <400>;
		height = <240>;
	};
};

/* SD card, SDC_CS_PIN as a plain GPIO chip-select. */
sd_spi: &spi1 {
	compatible = "nordic,nrf-spi";
	status = "okay";
	cs-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	sdcard: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <4000000>;

		sdmmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/* External QSPI NOR: MT25QL128 (libraries/SST/mt25.c), JEDEC ID 20 BA 18 --
 * a different chip from the DK's on-board MX25R6435F (Phase 4). Kept
 * single-line SPI mode (default readoc/writeoc, quad-enable-requirements =
 * NONE so the driver never touches the QE bit) for this first bring-up on
 * real, never-before-flashed hardware -- quad I/O is a later optimization,
 * not needed to prove the chip works. */
&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	/* Labeled mx25r64 (the DK's actual chip, not this board's) for the
	 * same main.c source-compat reason as arduino_i2c/arduino_serial
	 * above -- the real chip here is MT25QL128, see jedec-id below. */
	mx25r64: mt25ql128@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		sck-frequency = <8000000>;
		jedec-id = [20 ba 18];
		size = <134217728>;
		quad-enable-requirements = "NONE";
	};
};

/* Raw NOR-as-USB-disk: the chip holds raw data, not a filesystem, so it's
 * exposed as a second, unformatted USB MSC LUN (see usb_demo.c) rather
 * than mounting anything. Needs *two* pieces together: the
 * "nordic,pm-ext-flash" chosen entry above (so PM treats mx25r64 as an
 * "external_flash" region at all) and the pm_static_stravav11_nrf52840.yml
 * partition (region: external_flash, affiliation: disk) that supplies the
 * name, cache_size, sector_size and read_only extra_params flashdisk.c's
 * PM-affiliation code path reads -- a hand-written devicetree
 * fixed-partitions node alone (tried during Phase 4, DK-only at the time)
 * isn't visible to PM's own scan for that half.
 *
 * What that path does NOT get from pm_static.yml, despite being in the
 * "PM" branch: offset/size/area-id. Those come from
 * FIXED_PARTITION_OFFSET/SIZE/ID(n), which -- confirmed by reading
 * flash_map.h -- expand to DT_REG_ADDR/SIZE(DT_NODELABEL(n)), i.e. a
 * plain devicetree lookup, always, regardless of Partition Manager. `n`
 * is the affiliation macro's own uppercased partition-name token
 * (PM_FOREACH_AFFILIATED_TO_disk(fn) = fn(EXTERNAL_FLASH_DISK), confirmed
 * in the build's pm.config) -- so this devicetree node's *label* must be
 * that exact uppercase token for FIXED_PARTITION_SIZE to resolve at all.
 * First attempt used an arbitrary lowercase label + a tiny 0x1000
 * placeholder reg (reasoning: "PM supplies the real numbers") and built
 * clean but silently produced a real, zero-byte USB disk on real
 * hardware (lsblk: "0B") -- DT_NODELABEL of a non-matching label doesn't
 * error, it just resolves to nothing and DT_REG_SIZE of that is 0. Fixed
 * by matching both the label and the reg range to the pm_static.yml
 * partition exactly; the two must be kept in sync by hand since nothing
 * cross-checks them. */
&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Label and reg MUST match pm_static_stravav11_nrf52840.yml's
		 * external_flash_disk partition (address 0x0, size 0x1000000)
		 * -- see the comment above for why. */
		EXTERNAL_FLASH_DISK: partition@0 {
			label = "external_flash_disk";
			reg = <0x0 0x1000000>;
		};
	};
};

/ {
	nor_msc_disk: nor-msc-disk {
		compatible = "zephyr,flash-disk";
		partition = <&EXTERNAL_FLASH_DISK>;
		/* disk-name/cache-size here are unused (see comment above --
		 * flashdisk.c's PM-affiliation path takes the real disk name
		 * from pm_static.yml's extra_params.disk_name instead), kept
		 * only because the devicetree binding requires them. */
		disk-name = "NOR_DT_UNUSED";
		cache-size = <4096>;
	};
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";

	/* Phase 9 CDC-ACM: usb_demo.c's DEVICE_DT_GET_ONE(zephyr_cdc_acm_uart)
	 * needs this child node, same as the DK overlay. */
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "stravaV11 CDC-ACM";
	};
};
