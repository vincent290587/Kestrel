/*
 * Phase 2 DK bring-up wiring: the LS027 isn't attached to this DK (see
 * CLAUDE.md) -- this puts it on the Arduino-header SPI bus (spi3) at
 * arbitrary pins, purely so the sharp,ls0xx driver + display subsystem
 * builds, initializes, and runs its SPI transactions without error. Real
 * pin assignments come back when the custom PCB's own board definition is
 * written (a later phase); nothing here should be read as the final wiring.
 *
 * No VCOM-related properties: on the real PCB, VCOM is toggled by a
 * hardware circuit, not software at all (confirmed with the user during
 * Phase 11) -- ls0xx.c gates all of its VCOM-toggling code behind
 * DT_INST_NODE_HAS_PROP(0, extcomin_gpios), so omitting both that and
 * serial-vcom-inversion (which also doesn't exist in the driver's
 * devicetree binding at the sdk-nrf v3.2.4 this workspace is now pinned
 * to -- see CLAUDE.md Phase 11) means the driver only ever does plain SPI
 * content writes here, matching the real board's node.
 */

#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/ {
	chosen {
		zephyr,display = &ls027;
		/* Tells Partition Manager mx25r64 is a valid "external_flash"
		 * region -- see the raw-NOR-disk note further down, near the
		 * mx25r64 node itself. */
		nordic,pm-ext-flash = &mx25r64;
	};
};

/*
 * Phase 9: USB CDC-ACM. Unlike everything else in this file, &zephyr_udc0
 * is the chip's own on-die USB peripheral (already enabled by the DK's
 * default devicetree) -- real hardware, not a placeholder. Whether it's
 * actually host-visible depends on a physical USB cable being plugged into
 * the DK's own USB connector (separate from the J-Link USB used for
 * flashing/console), which is outside what this session could do itself.
 */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "stravaV11 CDC-ACM";
	};
};

&arduino_spi {
	status = "okay";
	/* index 0 -> ls027 (D10), index 1 -> SD card (D9), both placeholder
	 * pins -- see the Phase 4 storage note further down. */
	cs-gpios = <&arduino_header ARDUINO_HEADER_R3_D10 GPIO_ACTIVE_HIGH>,
		   <&arduino_header ARDUINO_HEADER_R3_D9 GPIO_ACTIVE_LOW>;

	ls027: ls0xx@0 {
		compatible = "sharp,ls0xx";
		reg = <0>;
		spi-max-frequency = <2000000>;
		width = <400>;
		height = <240>;
	};

	/*
	 * Phase 4 storage, SD card half: stravaV10 talks to a real SD card
	 * over SPI (source/sd/diskio_sdc.c, the old nRF5 SDK's
	 * nrf_block_dev_sdc component). No card or slot is physically
	 * present on this DK, so -- same as the display -- this only proves
	 * the zephyr,sdhc-spi-slot driver initializes and reports a clean
	 * error rather than hanging; it can't be validated further until a
	 * card is actually inserted.
	 */
	sdcard: sdhc@1 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <1>;
		status = "okay";
		spi-max-frequency = <4000000>;

		sdmmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/*
 * Phase 6 GPS bring-up: stravaV10 talks to the GlobalTop GPS module over a
 * dedicated UART (source/sensors/GPSMGMT.cpp), starting at 9600 baud
 * (GPS_DEFAULT_SPEED_BAUD) before switching to 115200. arduino_serial
 * (uart1) is disabled by default on this DK (unlike arduino_i2c/spi), so it
 * needs enabling here. No GPS module is attached -- same placeholder
 * caveat as the rest of this file; this only proves the UART peripheral
 * itself works (TX completes, RX doesn't hang). GPS_R/GPS_S/FIX_PIN
 * (reset/standby/fix-detect GPIOs) aren't wired up yet -- deferred with the
 * rest of GPSMGMT's hardware layer, same reasoning as Model.cpp in Phase 1.
 */
&arduino_serial {
	status = "okay";
	current-speed = <9600>;
};

/*
 * Phase 3 sensor bring-up, same caveat as above: nothing is physically
 * attached to this DK, so these addresses/wiring are placeholders (matching
 * stravaV10's actual addresses, which is all that matters for now) purely so
 * each driver builds and its init path runs cleanly against a real I2C
 * controller. arduino_i2c (i2c0) is already enabled by the DK's own default
 * devicetree -- see stravaV11_fw/prj.conf and CLAUDE.md.
 */
&arduino_i2c {
	bme280: bme280@76 {
		/* Active barometer per stravaV10's parameters.h (BARO_TYPE
		 * bme280); same 0x76 address as ms5637.c uses -- the two are
		 * alternate BOM options, never populated together. */
		compatible = "bosch,bme280";
		reg = <0x76>;
	};

	fxos8700: fxos8700@1e {
		compatible = "nxp,fxos8700";
		reg = <0x1e>;
	};

	fram: mb85rc@50 {
		/* Matches stravaV10's source/sensors/fram.c addressing
		 * exactly: base address 0x50 with the top address bits
		 * folded into the low bits of the 7-bit I2C address --
		 * that's what address-width = 8 (bits) + size = 2048
		 * (2^11 addressable bytes) reproduces in this driver. */
		compatible = "fujitsu,mb85rcxx";
		reg = <0x50>;
		size = <2048>;
		address-width = <8>;
	};
};

/*
 * Phase 4 storage, QSPI flash half: unlike everything above, this DK has a
 * *real* on-board QSPI NOR flash chip (MX25R6435F, 64Mbit), already wired up
 * and enabled by the DK's own default devicetree (&qspi / mx25r64 in
 * nrf52840dk_nrf52840.dts) -- no overlay needed to reach it. stravaV10's own
 * external flash is a different chip (MT25QL128 over QSPI,
 * libraries/SST/mt25.c) but the same JEDEC SPI-NOR protocol family, so
 * exercising this one via the plain Zephyr flash API (see storage_demo() in
 * main.c) is a real, hardware-validated stand-in for that storage path.
 *
 * Originally tried layering a zephyr,flash-disk + FAT filesystem on top (to
 * mirror stravaV10's actual FatFs usage), same as the fs_sample sample does
 * for internal flash. That hit an NCS-specific wall: this workspace's
 * Partition Manager is unconditionally active for any app built here (its
 * Kconfig is described as "read-only, do not change" -- it isn't a toggle),
 * and flashdisk.c's build only works for partitions PM itself allocated and
 * tagged with "disk" affiliation metadata; a hand-written devicetree
 * fixed-partitions node isn't visible to that scan. Direct flash_erase/
 * write/read against mx25r64 sidesteps flashdisk.c entirely and still
 * proves the chip works -- kept below, unchanged.
 *
 * Resolved (raw-NOR-over-USB update): the chip holds raw data, not a
 * filesystem, so this exposes it as a second, unformatted USB MSC LUN
 * instead (see usb_demo.c) -- real fix needed *two* pieces together, not
 * the pm_static.yml alone: the "nordic,pm-ext-flash" chosen entry above
 * (so PM treats mx25r64 as an "external_flash" region at all) and the
 * pm_static_nrf52840dk_nrf52840.yml partition (region: external_flash,
 * affiliation: disk) that supplies the name, cache_size, sector_size and
 * read_only extra_params flashdisk.c's PM-affiliation code path reads.
 *
 * What that path does NOT get from pm_static.yml, despite being in the
 * "PM" branch: offset/size/area-id. Those come from
 * FIXED_PARTITION_OFFSET/SIZE/ID(n), which -- confirmed by reading
 * flash_map.h -- expand to DT_REG_ADDR/SIZE(DT_NODELABEL(n)), i.e. a
 * plain devicetree lookup, always, regardless of Partition Manager. `n`
 * is the affiliation macro's own uppercased partition-name token
 * (PM_FOREACH_AFFILIATED_TO_disk(fn) = fn(EXTERNAL_FLASH_DISK), confirmed
 * in the build's pm.config) -- so this devicetree node's *label* must be
 * that exact uppercase token for FIXED_PARTITION_SIZE to resolve at all.
 * First attempt used an arbitrary lowercase label + a tiny 0x1000
 * placeholder reg (reasoning: "PM supplies the real numbers") and built
 * clean but silently produced a real, zero-byte USB disk on real
 * hardware (lsblk: "0B") -- DT_NODELABEL of a non-matching label doesn't
 * error, it just resolves to nothing and DT_REG_SIZE of that is 0. Fixed
 * by matching both the label and the reg range to the pm_static.yml
 * partition exactly; the two must be kept in sync by hand since nothing
 * cross-checks them.
 */
&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Label and reg MUST match pm_static_nrf52840dk_nrf52840.yml's
		 * external_flash_disk partition (address 0x0, size 0x800000)
		 * -- see the comment above for why. */
		EXTERNAL_FLASH_DISK: partition@0 {
			label = "external_flash_disk";
			reg = <0x0 0x800000>;
		};
	};
};

/ {
	nor_msc_disk: nor-msc-disk {
		compatible = "zephyr,flash-disk";
		partition = <&EXTERNAL_FLASH_DISK>;
		/* disk-name/cache-size here are unused (see comment above --
		 * flashdisk.c's PM-affiliation path takes the real disk name
		 * from pm_static.yml's extra_params.disk_name instead), kept
		 * only because the devicetree binding requires them. */
		disk-name = "NOR_DT_UNUSED";
		cache-size = <4096>;
	};
};
