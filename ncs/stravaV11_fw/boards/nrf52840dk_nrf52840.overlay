/*
 * Phase 2 DK bring-up wiring: the LS027 isn't attached to this DK (see
 * CLAUDE.md) -- this puts it on the Arduino-header SPI bus (spi3) at
 * arbitrary pins, purely so the sharp,ls0xx driver + display subsystem
 * builds, initializes, and runs its SPI transactions without error. Real
 * pin assignments come back when the custom PCB's own board definition is
 * written (a later phase); nothing here should be read as the final wiring.
 *
 * width/height (400x240) and serial-vcom-inversion (no EXTCOMIN pin) match
 * stravaV10's own drivers/lcd/ls027.c, which toggles VCOM in-band over SPI
 * rather than via a dedicated EXTCOMIN GPIO.
 */

#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/ {
	chosen {
		zephyr,display = &ls027;
	};
};

&arduino_spi {
	status = "okay";
	/* index 0 -> ls027 (D10), index 1 -> SD card (D9), both placeholder
	 * pins -- see the Phase 4 storage note further down. */
	cs-gpios = <&arduino_header ARDUINO_HEADER_R3_D10 GPIO_ACTIVE_HIGH>,
		   <&arduino_header ARDUINO_HEADER_R3_D9 GPIO_ACTIVE_LOW>;

	ls027: ls0xx@0 {
		compatible = "sharp,ls0xx";
		reg = <0>;
		spi-max-frequency = <2000000>;
		width = <400>;
		height = <240>;
		serial-vcom-inversion;
		serial-vcom-interval = <1000>;
	};

	/*
	 * Phase 4 storage, SD card half: stravaV10 talks to a real SD card
	 * over SPI (source/sd/diskio_sdc.c, the old nRF5 SDK's
	 * nrf_block_dev_sdc component). No card or slot is physically
	 * present on this DK, so -- same as the display -- this only proves
	 * the zephyr,sdhc-spi-slot driver initializes and reports a clean
	 * error rather than hanging; it can't be validated further until a
	 * card is actually inserted.
	 */
	sdcard: sdhc@1 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <1>;
		status = "okay";
		spi-max-frequency = <4000000>;

		sdmmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/*
 * Phase 6 GPS bring-up: stravaV10 talks to the GlobalTop GPS module over a
 * dedicated UART (source/sensors/GPSMGMT.cpp), starting at 9600 baud
 * (GPS_DEFAULT_SPEED_BAUD) before switching to 115200. arduino_serial
 * (uart1) is disabled by default on this DK (unlike arduino_i2c/spi), so it
 * needs enabling here. No GPS module is attached -- same placeholder
 * caveat as the rest of this file; this only proves the UART peripheral
 * itself works (TX completes, RX doesn't hang). GPS_R/GPS_S/FIX_PIN
 * (reset/standby/fix-detect GPIOs) aren't wired up yet -- deferred with the
 * rest of GPSMGMT's hardware layer, same reasoning as Model.cpp in Phase 1.
 */
&arduino_serial {
	status = "okay";
	current-speed = <9600>;
};

/*
 * Phase 3 sensor bring-up, same caveat as above: nothing is physically
 * attached to this DK, so these addresses/wiring are placeholders (matching
 * stravaV10's actual addresses, which is all that matters for now) purely so
 * each driver builds and its init path runs cleanly against a real I2C
 * controller. arduino_i2c (i2c0) is already enabled by the DK's own default
 * devicetree -- see stravaV11_fw/prj.conf and CLAUDE.md.
 */
&arduino_i2c {
	bme280: bme280@76 {
		/* Active barometer per stravaV10's parameters.h (BARO_TYPE
		 * bme280); same 0x76 address as ms5637.c uses -- the two are
		 * alternate BOM options, never populated together. */
		compatible = "bosch,bme280";
		reg = <0x76>;
	};

	fxos8700: fxos8700@1e {
		compatible = "nxp,fxos8700";
		reg = <0x1e>;
	};

	fram: mb85rc@50 {
		/* Matches stravaV10's source/sensors/fram.c addressing
		 * exactly: base address 0x50 with the top address bits
		 * folded into the low bits of the 7-bit I2C address --
		 * that's what address-width = 8 (bits) + size = 2048
		 * (2^11 addressable bytes) reproduces in this driver. */
		compatible = "fujitsu,mb85rcxx";
		reg = <0x50>;
		size = <2048>;
		address-width = <8>;
	};
};

/*
 * Phase 4 storage, QSPI flash half: unlike everything above, this DK has a
 * *real* on-board QSPI NOR flash chip (MX25R6435F, 64Mbit), already wired up
 * and enabled by the DK's own default devicetree (&qspi / mx25r64 in
 * nrf52840dk_nrf52840.dts) -- no overlay needed to reach it. stravaV10's own
 * external flash is a different chip (MT25QL128 over QSPI,
 * libraries/SST/mt25.c) but the same JEDEC SPI-NOR protocol family, so
 * exercising this one via the plain Zephyr flash API (see storage_demo() in
 * main.c) is a real, hardware-validated stand-in for that storage path.
 *
 * Originally tried layering a zephyr,flash-disk + FAT filesystem on top (to
 * mirror stravaV10's actual FatFs usage), same as the fs_sample sample does
 * for internal flash. That hit an NCS-specific wall: this workspace's
 * Partition Manager is unconditionally active for any app built here (its
 * Kconfig is described as "read-only, do not change" -- it isn't a toggle),
 * and flashdisk.c's build only works for partitions PM itself allocated and
 * tagged with "disk" affiliation metadata; a hand-written devicetree
 * fixed-partitions node isn't visible to that scan, which is a real,
 * separate follow-up (a pm_static.yml would be the fix) rather than
 * something to force through here. Direct flash_erase/write/read against
 * mx25r64 sidesteps flashdisk.c entirely and still proves the chip works.
 */
