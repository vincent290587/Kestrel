# stravaV10 is its own git repo (separate remote/history) checked out as a
# reference subfolder for this port -- not tracked here.
/stravaV10/

# Python venv for west/Zephyr tooling.
/.venv/

# ncs/ is the west workspace: everything in it except our own applications
# (stravaV11_app, stravaV11_fw, stravaV11_ant) is third-party (Zephyr,
# sdk-nrf, mcuboot, ...), each already its own git checkout managed by
# `west update`. ncs/ant/ is additionally license-gated, proprietary vendor
# source (ANT+ Adopter agreement) -- never track it here regardless.
/ncs/*
!/ncs/stravaV11_app/
!/ncs/stravaV11_fw/
!/ncs/stravaV11_ant/

# Claude Code session state, not project content.
/.claude/

# Personal working TODO list, not project documentation.
/todo.md

# RISC-V sandbox research spike (see ncs/stravaV11_app/lib/source/riscv/
# rv32_emu.h): guest binaries are build.sh output, not source -- generated
# by a toolchain (gcc-riscv64-unknown-elf) that isn't part of the normal
# west/Zephyr toolchain this repo otherwise depends on, so they're rebuilt
# on demand rather than committed.
/ncs/stravaV11_app/tools/riscv_guest/*.elf
/ncs/stravaV11_app/tools/riscv_guest/*.bin

# User-provided ANT+ license key (not build-generated -- placed here
# deliberately). stravaV11_fw/CMakeLists.txt extracts the key string from
# this header at configure time and feeds it to Kconfig's
# CONFIG_ANT_LICENSE_KEY via a generated conf fragment (sdk-ant reads a
# Kconfig string, not a header define, for this -- see that CMakeLists.txt).
# Kept out of git as credential-like material, same as any license/API key.
/ANT_license.h

# Project-specific MCUboot image-signing private key (generated once via
# imgtool.py keygen, referenced by stravaV11_fw/sysbuild.conf's
# SB_CONFIG_BOOT_SIGNATURE_KEY_FILE). Before this, the build used
# MCUboot's own upstream root-ec-p256.pem sample key -- fine for early
# bring-up, but that key's private half is public (checked into the open
# source mcuboot repo), so anyone could forge an image MCUboot would
# accept. Never commit this file: whoever holds it can sign a firmware
# image this board's bootloader will trust. See COMMANDS.md for
# regeneration/rotation.
/mcuboot_signing_key.pem
