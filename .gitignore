# stravaV10 is its own git repo (separate remote/history) checked out as a
# reference subfolder for this port -- not tracked here.
/stravaV10/

# Python venv for west/Zephyr tooling.
/.venv/

# ncs/ is the west workspace: everything in it except our own applications
# (stravaV11_app, stravaV11_fw, stravaV11_ant) is third-party (Zephyr,
# sdk-nrf, mcuboot, ...), each already its own git checkout managed by
# `west update`. ncs/ant/ is additionally license-gated, proprietary vendor
# source (ANT+ Adopter agreement) -- never track it here regardless.
/ncs/*
!/ncs/stravaV11_app/
!/ncs/stravaV11_fw/
!/ncs/stravaV11_ant/

# Claude Code session state, not project content.
/.claude/

# User-provided ANT+ license key (not build-generated -- placed here
# deliberately). Not currently wired into any build (prj.conf still uses
# CONFIG_ANT_EVALUATION_KEY, not this). Kept out of git as credential-like
# material, same as any license/API key.
/ANT_license.h
